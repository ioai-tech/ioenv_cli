# Onboard deployment environment (Jetson/G1 robot)
# Real-time scheduling, privileged mode, SSH enabled

IMAGE_NAME="ioaitech/ioenv-onboard:1.4"
CONTAINER_NAME="onboard_env"
DATA_VOLUME_NAME="onboard_home"
MEDIA_VOLUME_NAME="onboard_media"
HOST_WORKSPACE="onboard_ws"

# Feature flags
ENABLE_X11=false
ENABLE_SSH=true
ENABLE_START_CMD=true

# Docker run arguments
# --privileged: Full access to host devices
# --cap-add=SYS_NICE: Enables real-time scheduling for ROS2 controller_manager
# ulimit rtprio/memlock: Required for real-time scheduling
CUSTOM_RUN_ARGS=(
    "-v" "$HOME/ioenv_ws/$HOST_WORKSPACE:/root/workspace:rw"
    "--privileged"
    "--cap-add=SYS_NICE"
    "--ulimit" "rtprio=99"
    "--ulimit" "memlock=-1"
)
