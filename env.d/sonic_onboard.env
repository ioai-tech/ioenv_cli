# sonic_onboard environment
# Sonic On-Board Deploy for Jetson (GR00T WholeBodyControl)
# Base image: nvcr.io/nvidia/l4t-jetpack:r36.4.0

IMAGE_NAME="ioaitech/sonic_onboard:1.0"
CONTAINER_NAME="sonic_onboard_env"
DATA_VOLUME_NAME="sonic_onboard_home"
MEDIA_VOLUME_NAME="sonic_onboard_media"
DOCKERFILE="sonic_onboard.Dockerfile"
HOST_WORKSPACE="sonic_onboard_ws"

# Feature flags
ENABLE_X11=false
ENABLE_SSH=true
ENABLE_START_CMD=false

# Build configuration
BUILD_NETWORK_HOST=true

# Docker run arguments
# Jetson on-board deployment: privileged + runtime nvidia + host libs
CUSTOM_RUN_ARGS=(
    "--runtime" "nvidia"
    "--gpus" "all"
    "--privileged"
    "-v" "$HOME/ioenv_ws/$HOST_WORKSPACE:/root/workspace:rw"
    "-e" "NVIDIA_VISIBLE_DEVICES=all"
    "-e" "NVIDIA_DRIVER_CAPABILITIES=compute,utility"
    "-e" "RMW_IMPLEMENTATION=rmw_fastrtps_cpp"
    "-e" "ROS_DOMAIN_ID=0"
    # Mount Jetson NVIDIA DLA libraries from host
    "-v" "/usr/lib/aarch64-linux-gnu/nvidia:/usr/lib/aarch64-linux-gnu/nvidia:ro"
    # Mount host CUDA toolkit (libcudla, libnvcudla, libnvos)
    "-v" "/usr/local/cuda:/usr/local/cuda:ro"
    # Mount Jetson device nodes
    "--device" "/dev/nvidia0:/dev/nvidia0"
    "--device" "/dev/nvidiactl:/dev/nvidiactl"
    "--device" "/dev/nvidia-modeset:/dev/nvidia-modeset"
    "--device" "/dev/nvhost-ctrl:/dev/nvhost-ctrl"
    "--device" "/dev/nvhost-ctrl-gpu:/dev/nvhost-ctrl-gpu"
    "--device" "/dev/nvhost-prof-gpu:/dev/nvhost-prof-gpu"
    "--device" "/dev/nvmap:/dev/nvmap"
    "--device" "/dev/nvhost-gpu:/dev/nvhost-gpu"
    "--device" "/dev/nvhost-as-gpu:/dev/nvhost-as-gpu"
    "--device" "/dev/nvhost-vic:/dev/nvhost-vic"
)
