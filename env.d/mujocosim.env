# MuJoCoSim simulation environment
# X11 graphics, GPU passthrough, joystick support

IMAGE_NAME="ioaitech/ioenv-mujocosim:1.4"
CONTAINER_NAME="mujocosim_env"
DATA_VOLUME_NAME="mujocosim_home"
MEDIA_VOLUME_NAME="mujocosim_media"
HOST_WORKSPACE="mujocosim_ws"

# Feature flags
ENABLE_X11=true
ENABLE_SSH=true
ENABLE_START_CMD=false

# Docker run arguments
CUSTOM_RUN_ARGS=(
    "--gpus" "all"
    "-e" "NVIDIA_VISIBLE_DEVICES=all"
    "-e" "NVIDIA_DRIVER_CAPABILITIES=all,graphics,display"
    "-e" "DISPLAY=$DISPLAY"
    "-e" "QT_X11_NO_MITSHM=1"
    "-v" "/tmp/.X11-unix:/tmp/.X11-unix"
    "-v" "/usr/share/vulkan/icd.d:/usr/share/vulkan/icd.d:ro"
    "-v" "/usr/share/glvnd/egl_vendor.d:/usr/share/glvnd/egl_vendor.d:ro"
    "-v" "/etc/vulkan:/etc/vulkan:ro"
    "-v" "$HOME/ioenv_ws/$HOST_WORKSPACE:/root/workspace:rw"
    "--device" "/dev/input/js0"
)
