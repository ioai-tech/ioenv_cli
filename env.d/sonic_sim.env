# sonic_sim environment
# Sonic On-Board Deploy for Jetson (GR00T WholeBodyControl)
# Base image: nvcr.io/nvidia/l4t-jetpack:r36.4.0

IMAGE_NAME="ioaitech/sonic_sim:1.0"
CONTAINER_NAME="sonic_sim_env"
DATA_VOLUME_NAME="sonic_sim_home"
MEDIA_VOLUME_NAME="sonic_sim_media"
DOCKERFILE="sonic_sim.Dockerfile"
HOST_WORKSPACE="sonic_sim_ws"

# Feature flags
ENABLE_X11=false
ENABLE_SSH=true
ENABLE_START_CMD=false

# Build configuration
BUILD_NETWORK_HOST=true

# Docker run arguments
# Jetson on-board deployment: privileged + runtime nvidia + host libs
CUSTOM_RUN_ARGS=(
    "--runtime" "nvidia"
    "--gpus" "all"
    "--privileged"
    "-e" "DISPLAY=$DISPLAY"
    "-e" "QT_X11_NO_MITSHM=1"
    "-v" "/tmp/.X11-unix:/tmp/.X11-unix"
    "-v" "$HOME/.Xauthority:/root/.Xauthority:ro"
    "-v" "$HOME/ioenv_ws/$HOST_WORKSPACE:/root/workspace:rw"
    "-e" "NVIDIA_VISIBLE_DEVICES=all"
    "-e" "NVIDIA_DRIVER_CAPABILITIES=compute,utility"
    "-e" "RMW_IMPLEMENTATION=rmw_fastrtps_cpp"
    "-e" "ROS_DOMAIN_ID=0"
)