# sonic_train environment
# IsaacSim 5.1.0 + IsaacLab 2.3.2 training environment
# Base image: osrf/ros:humble-desktop-full

IMAGE_NAME="ioaitech/sonic_train:1.0"
CONTAINER_NAME="sonic_train_env"
DATA_VOLUME_NAME="sonic_train_home"
MEDIA_VOLUME_NAME="sonic_train_media"
DOCKERFILE="sonic_train.Dockerfile"
HOST_WORKSPACE="sonic_train_ws"

# Feature flags
ENABLE_X11=true
ENABLE_SSH=true
ENABLE_START_CMD=false

# Build configuration
BUILD_NETWORK_HOST=true

# Docker run arguments
CUSTOM_RUN_ARGS=(
    "-v" "$HOME/ioenv_ws/$HOST_WORKSPACE:/root/workspace:rw"
    "--gpus" "all"
    "-e" "NVIDIA_VISIBLE_DEVICES=all"
    "-e" "NVIDIA_DRIVER_CAPABILITIES=all"
    "-e" "DISPLAY=$DISPLAY"
    "-e" "QT_X11_NO_MITSHM=1"
    "-v" "/tmp/.X11-unix:/tmp/.X11-unix"
    "-v" "$HOME/.Xauthority:/root/.Xauthority:ro"
    "-v" "/usr/share/vulkan/icd.d:/usr/share/vulkan/icd.d:ro"
    "-v" "/usr/share/glvnd/egl_vendor.d:/usr/share/glvnd/egl_vendor.d:ro"
    "-v" "/etc/vulkan:/etc/vulkan:ro"
)